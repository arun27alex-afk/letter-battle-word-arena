rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(roomData) {
      return signedIn() && request.auth.uid in roomData.playerUids;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.players.size() == 1
        && request.resource.data.players[0].uid == request.auth.uid;

      // A signed-in user must be able to read a room code before joining it.
      allow read: if signedIn();

      // Client transactions enforce turns; room membership prevents outsiders.
      allow update: if signedIn()
        && (isMember(resource.data)
          || (resource.data.players.size() == 1
            && request.resource.data.players.size() == 2
            && request.resource.data.players[1].uid == request.auth.uid));

      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if signedIn()
          && isMember(get(/databases/$(database)/documents/rooms/$(roomId)).data);
        allow update, delete: if false;
      }

      match /voice/{voiceId} {
        allow read, write: if signedIn()
          && isMember(get(/databases/$(database)/documents/rooms/$(roomId)).data);

        match /{subCollection}/{candidateId} {
          allow read, write: if signedIn()
            && isMember(get(/databases/$(database)/documents/rooms/$(roomId)).data);
        }
      }
    }
  }
}
